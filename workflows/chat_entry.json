              "value": "={{ $json.body.text }}",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "id": "4d7c6f0f-c5e0-43bc-9937-f3b0f2a44076",
      "name": "Normalize Envelope",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        760,
        300
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "-- One open conversation per (tenant, customer) is enforced by the\n-- partial unique index in db/schema.sql. Returns conversation_id.\nWITH conv AS (\n  INSERT INTO conversations (tenant_id, customer_id, channel)\n  VALUES ($1, $2, $3)\n  ON CONFLICT (tenant_id, customer_id) WHERE status = 'open' DO NOTHING\n  RETURNING id\n)\nINSERT INTO messages (tenant_id, conversation_id, direction, sender, body)\nSELECT $1, id, 'in', 'customer', $4 FROM conv;\n-- params: $1 tenant_id, $2 customer_id, $3 channel, $4 text",
        "options": {}
      },
      "id": "3c1c33f4-9462-4ddc-802f-37844923f556",
      "name": "Open Conversation + Save Incoming Message",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        980,
        300
      ]
    },
    {
      "parameters": {
        "functionCode": "// STUB - runtime phase wires this to the Git checkout of this repo.\n// Reads packs/<tenant_id>.json, validates it against packs/schema.json,\n// runs the prompt builder (prompts/build_prompt.py logic), and returns:\n// { pack, system_prompt, tools_on: [...] }\n// Only tools listed in tools_on are registered for the agent session.\nreturn items;"
      },
      "id": "bf3055d3-e379-4b90-942b-99a0c667e7da",
      "name": "Load Pack + Build Prompt (stub)",
      "type": "n8n-nodes-base.function",
      "typeVersion": 1,
      "position": [
        1200,
        300
      ]
    },
    {
      "parameters": {
        "functionCode": "// PLACEHOLDER - no credentials in this repo, by design.\n// Runtime phase: replace with the Gemini (Vertex AI) agent node.\n// Inputs: system_prompt + conversation history + registered tools.\n// Output contract (one JSON item):\n// { intent: 'question' | 'booking' | 'handover' | 'smalltalk',\n//   reply_text: string,\n//   lead: { name, phone, need } | null,\n//   booking_request: { service_id, starts_at } | null,\n//   handover_reason: string | null }\nreturn items;"
      },
      "id": "e73e166a-789f-40e2-8d81-168222c70479",
      "name": "AI AGENT - PLACEHOLDER (Gemini via Vertex AI)",
      "type": "n8n-nodes-base.function",
      "typeVersion": 1,
      "position": [
        1420,
        300
      ]
    },
    {
      "parameters": {
        "functionCode": "// CONTRACT STUB - invoked by the agent at runtime, not a pipeline step.\n// answer(question: string) -> { found: boolean, answer: string | null }\n// Looks up the tenant pack's FAQs and facts for THIS tenant only.\n// found=false means the agent must say it will check with the owner\n// and call owner_alert. It must never invent an answer."
      },
      "id": "5433b18f-6c2c-4b07-838e-8a68ab488aca",
      "name": "TOOL CONTRACT STUB - answer",
      "type": "n8n-nodes-base.function",
      "typeVersion": 1,
      "position": [
        1420,
        620
      ]
    },
    {
      "parameters": {
        "functionCode": "// CONTRACT STUB - invoked by the agent at runtime.\n// lead_capture(name, phone, need) -> upserts one row in leads on\n// (tenant_id, customer_id) and writes a 'lead captured' register event.\n// Called as soon as name + phone + need are known, even with no booking."
      },
      "id": "d738aed1-48a7-4cb7-bf74-99031c8baa8c",
      "name": "TOOL CONTRACT STUB - lead_capture",
      "type": "n8n-nodes-base.function",
      "typeVersion": 1,
      "position": [
        1420,
        820
      ]
    },
    {
      "parameters": {
        "functionCode": "// CONTRACT STUB - invoked by the agent at runtime.\n// owner_alert(summary: string) -> inserts a register_events row of type\n// 'owner_alert', marks the conversation status='handed_over', and (in the\n// runtime phase) notifies the owner on the pack's owner_alerts channel.\n// After handover the agent stops replying until the owner releases it."
      },
      "id": "7ce98fc7-58cd-4ec3-a6a4-6ac62303e8d2",
      "name": "TOOL CONTRACT STUB - owner_alert",
      "type": "n8n-nodes-base.function",
      "typeVersion": 1,
      "position": [
        1420,
        1020
      ]
    },
