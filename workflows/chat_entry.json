    {
      "parameters": {
        "operation": "executeQuery",
        "query": "-- Saves the outgoing reply. If the lead is captured but has no booking\n-- and no nudge is scheduled yet, the follow-up insert runs too; the\n-- partial unique index on followups makes the second part a no-op\n-- when a nudge already exists.\nINSERT INTO messages (tenant_id, conversation_id, direction, sender, body)\nVALUES ($1, $2, 'out', 'agent', $3);",
        "options": {}
